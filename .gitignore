# 二改：反代服务的本地产物与运行数据
# data/state.json 里有管理口令哈希、API 密钥、管理令牌与审计日志，绝不入库。
reverse-proxy/data/
reverse-proxy/build/
reverse-proxy/dist/
# 只忽略 spec 备份；wb-reverse-proxy.spec 是构建脚本，必须入库（CI 靠它打 exe）
reverse-proxy/*.spec.bak
reverse-proxy/*.spec.orig
# 打包时由 build-exe.py 生成、spec 负责打进包内的版本文件。
# 它是构建产物（每次打包按 package.json 重写），入库只会制造无意义的 diff；
# 版本的唯一来源是 package.json。
reverse-proxy/version.json
__pycache__/
*.py[cod]

# Companion 嵌入产物（由 scripts/prepare-agent-companion.mjs 生成）
vendor/agent-companion/dist-embed*
src-tauri/dist-embed*

# 重建时被改名挪走的旧构建产物（dist.old-<时间戳>），别提交
dist.old-*
dist.old-*/

# AI 工具本地配置
.codebuddy/
.cursor/
.agents/
.codex/
.grok/
/.workbuddy/
/AGENTS.md

# ── 二改：本地构建缓存与临时产物（开源前核对，别把本机垃圾推上去）─────────

# esbuild / node 编译缓存（构建脚本为绕开 %TEMP% 问题建在仓库内的）
.tmp-esbuild/

# pytest 的临时目录（--basetemp 指向仓库内时会产生）
reverse-proxy/.pytest-tmp/
.pytest-tmp/
.pytest_cache/

# 打包出来的源码快照 zip（由发版脚本生成，不该入库）
version/*/*.zip

# Windows / 编辑器残留
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── 二改：AI 辅助分析的本地工作区（纯本机产物，不参与构建）──────────────
# 里面有 .venv（约 180 MB）、源码备份快照、浏览器截图、分析脚本与报告。
# 体积大、含本机绝对路径，任何情况下都不该入库。
_hyact_work/

# ── 二改：Tauri 构建时自动生成的 schema ──────────────────────────────
# tauri build / tauri dev 每次都会重写这四个文件，内容由 CLI 版本决定。
# 入库只会制造无意义的 diff（CLI 一升级就全变），且 CI 自己会生成。
src-tauri/gen/schemas/

# ── 二改：反代运行数据（补充上面的 data/ 规则）───────────────────────
# data/ 整目录已忽略；这里再点名具体文件，防止有人用 git add -f 绕过，
# 或在别的路径放同名文件 —— settings.key 是加密密钥，泄露它等同于
# 交出「解密 state.json 里已加密字段」的能力。
settings.key
state.json
state.json.bak
request-log.jsonl
